{
  "manifest_version": 3,
  "name": "栖页 · 标签整理与内存管理",
  "short_name": "栖页",
  "version": "1.3.0",
  "description": "在侧边栏或弹窗整理 Chrome 原生标签组，并按组手动释放后台网页内容。",
  "minimum_chrome_version": "140",
  "permissions": ["tabs", "tabGroups", "storage", "contextMenus", "sidePanel"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "栖页：标签整理与内存管理",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
